# CheckMeOut frontend settings.
# The defaults below are already built in for local development, so you only
# need a .env.local file if you want to change something.
# Never put secrets in variables that start with NEXT_PUBLIC_ (they are sent to browsers).

# The domain everything lives under. Locally "localhost"; in production "checkmeout.in".
# A port is optional and ignored when matching (localhost:3000 works too).
ROOT_DOMAIN=localhost

# The subdomain that serves the creator dashboard (app.localhost / app.checkmeout.in).
APP_SUBDOMAIN=app

# Where the FastAPI backend runs. Dashboard requests to /api/* are forwarded here.
API_ORIGIN=http://127.0.0.1:8000

# Allow opening portfolios as /_preview/<username> on hosts that are not under
# ROOT_DOMAIN (e.g. Vercel preview URLs). Keep "false" in production.
ENABLE_PREVIEW_PATHS=false
